  "technique.portable_pocket_cabin.chopping": "Chopping",
  "technique.portable_pocket_cabin.chopping.description": "Cut into rough, even pieces with a knife. Pieces of the same size cook at the same rate, and smaller pieces cook faster and give more flavour to a dish.",
  "technique.portable_pocket_cabin.dicing": "Dicing",
  "technique.portable_pocket_cabin.dicing.description": "Cut into small, even cubes, so that every piece cooks through at the same time.",
  "technique.portable_pocket_cabin.slicing": "Slicing",
  "technique.portable_pocket_cabin.slicing.description": "Cut into thin, flat pieces. Thin slices brown quickly in a hot pan and cook through before they dry out.",
  "technique.portable_pocket_cabin.searing": "Searing",
  "technique.portable_pocket_cabin.searing.description": "Cook meat or fish in a very hot pan. The heat browns the surface through the Maillard reaction, which makes much of the flavour of roasted food.",
  "technique.portable_pocket_cabin.frying": "Frying",
  "technique.portable_pocket_cabin.frying.description": "Cook in a pan with a little fat at a steady heat, so the inside cooks through while the outside turns golden.",
  "technique.portable_pocket_cabin.sauteing": "Sautéing",
  "technique.portable_pocket_cabin.sauteing.description": "Cook small pieces quickly in a little fat, moving them often. Mushrooms first release their water, then brown once it has boiled away.",
  "technique.portable_pocket_cabin.simmering": "Simmering",
  "technique.portable_pocket_cabin.simmering.description": "Cook in liquid kept just below the boil. Gentle bubbles soften vegetables and draw their flavour into the broth without breaking them apart.",
  "technique.portable_pocket_cabin.stewing": "Stewing",
  "technique.portable_pocket_cabin.stewing.description": "Cook meat and vegetables slowly in a little liquid. Long, gentle heat turns tough connective tissue into gelatin, which makes the meat tender.",
  "technique.portable_pocket_cabin.baking": "Baking",
  "technique.portable_pocket_cabin.baking.description": "Cook with dry heat all around, in a closed oven. Starches set, sugars brown, and steam and gas from eggs make doughs and batters rise.",
  "technique.portable_pocket_cabin.drying": "Drying",
